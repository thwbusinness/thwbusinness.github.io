# Kopieren nach .env und ausfüllen. Die Datei gehört NICHT ins Repository.

# --- Pflicht ---
DB_PASSWORT=hier-ein-langes-zufaelliges-passwort
JWT_SECRET=hier-mindestens-32-zufaellige-zeichen
API_DOMAIN=api.deine-domain.de
API_URL=https://api.deine-domain.de
APP_URL=https://thwbusinness.github.io/frequenz/
ALLOWED_ORIGINS=https://thwbusinness.github.io

# Geheimnisse erzeugen:
#   openssl rand -base64 36

# --- Mailversand (sonst werden Links nur ins Log geschrieben) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Frequenz-Tagebuch <noreply@deine-domain.de>
SMTP_MODE=starttls

# --- Erinnerungen (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@deine-domain.de

# --- Optional ---
REQUIRE_EMAIL_CONFIRM=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_TOKEN=20
